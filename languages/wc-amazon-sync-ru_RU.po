#: Settings page
msgid "Amazon Sync"
msgstr "Синхронизация Amazon"

msgid "Settings"
msgstr "Настройки"

msgid "Import Products"
msgstr "Импорт товаров"

msgid "Export Products"
msgstr "Экспорт товаров"

msgid "Product Mapping"
msgstr "Сопоставление товаров"

#: Settings tabs
msgid "Amazon API"
msgstr "Amazon API"

msgid "Synchronization"
msgstr "Синхронизация"

msgid "Interface / Language"
msgstr "Интерфейс / Язык"

#: API settings
msgid "Region"
msgstr "Регион"

msgid "Seller ID"
msgstr "Seller ID"

msgid "Marketplace ID"
msgstr "Marketplace ID"

msgid "Client ID (LWA)"
msgstr "Client ID (LWA)"

